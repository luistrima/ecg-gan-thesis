    "def cargar_datos_reales(dataset, n_muestras):\n",
    "  ix = np.random.randint(0, dataset.shape[0], n_muestras)\n",
    "  aux_X = dataset[ix]\n",
    "  aux_X = np.asarray(aux_X)\n",
    "  aux_X = tf.convert_to_tensor(aux_X)\n",
    "  return aux_X"
   ]
